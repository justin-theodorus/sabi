# v2 only. Copy to .env.local, or pull the real values with:
#   vercel env pull v2/.env.local --yes      (run from the repo root)
# Note that pulling OVERWRITES the file, so the two model keys below have to be re-added after.

# Neon Postgres. The request path uses the HTTP driver; migrations use the WebSocket one.
DATABASE_URL=

# Model access. Unset SABI_MODEL_PROVIDER to use the Vercel AI Gateway, which is the default and
# what production runs: on Vercel it is authenticated by OIDC and needs no key at all. Locally it
# needs AI_GATEWAY_API_KEY. The gateway reports tokens and cost per request, which is where every
# figure in MEASUREMENTS.md comes from.
AI_GATEWAY_API_KEY=

# Set SABI_MODEL_PROVIDER=anthropic to bypass the gateway and call Anthropic directly. This exists
# because the gateway used to return 403 until the Vercel team had a card on file. It is resolved,
# and the escape hatch stays.
SABI_MODEL_PROVIDER=
ANTHROPIC_API_KEY=

# Optional. Points the scorer at another model; `npm run eval -- --model=<id>` sets it per run and
# stamps the id into the committed result file.
SABI_SCORING_MODEL=
