# v1 only. The seven-service stack reads these; v2 reads v2/.env.local instead.
# Copy to .env and fill in. docker-compose.yml loads this file.

# dialogue-engine: Claude
ANTHROPIC_API_KEY=

# dialogue-engine: ElevenLabs TTS. Optional; the stack runs without it, text only.
ELEVENLABS_API_KEY=

# Supabase hosts v1's Postgres and auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=   # safe to expose via NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=        # backend only, never expose to the frontend
SUPABASE_DB_URL=

# MinIO for local dev is hardcoded to minioadmin / minioadmin in docker-compose.yml.
